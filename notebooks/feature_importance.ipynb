   "source": [
    "# Feature importance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import joblib\n",
    "art = joblib.load('../artifacts/model.pkl')\n",
    "model = art['model']\n",
    "cols = art['feat_cols']\n",
    "for c, imp in sorted(zip(cols, model.feature_importances_), key=lambda x: -x[1]):\n",
    "    print('{:>14s}  {:.3f}'.format(c, imp))"
   ]
  }
 ],
